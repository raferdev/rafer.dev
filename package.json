{
  "name": "rafer.dev",
  "private": false,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=./packages/*",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "cz": "cz",
    "release": "changeset",
    "version": "changeset version",
    "prepare": "husky && git config commit.template .gitmessage || true"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{md,mdx,mjs,cjs,json,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10",
  "engines": {
    "node": "24.x",
    "pnpm": "10.x"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@manypkg/cli": "^0.25.1",
    "@next/eslint-plugin-next": "^16.3.4",
    "@types/eslint": "^9.6.1",
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.9.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "autoprefixer": "10.5.5",
    "chokidar": "^5.0.0",
    "commitizen": "^4.3.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-turbo": "^2.10.12",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-mdx": "^3.8.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "motion": "^13.2.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "pretty-quick": "^4.2.2",
    "puppeteer": "^25.10.0",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  }
}
